# Copy to .env.vm, set permissions to 600, and supply actual values privately.
DOCTA_WEB_DOMAIN=app.example.com
DOCTA_STORAGE_DOMAIN=storage.example.com
DOCTA_OIDC_ISSUER=https://identity.example.com
DOCTA_OIDC_JWKS_URL=https://identity.example.com/oauth/v2/keys
DOCTA_OIDC_AUDIENCE=replace-with-project-id
DOCTA_WEB_OIDC_CLIENT_ID=replace-with-public-client-id
DOCTA_WEB_SESSION_SECRET=replace-with-at-least-32-random-characters
POSTGRES_DB=docta
POSTGRES_USER=docta
POSTGRES_PASSWORD=replace-with-strong-secret
# Match the values above; percent-encode the username/password in this DSN.
DOCTA_VM_DATABASE_URL=postgresql://docta:replace-with-strong-secret@postgres:5432/docta
RUSTFS_ACCESS_KEY=replace-with-private-access-key
RUSTFS_SECRET_KEY=replace-with-private-secret-key
DOCTA_S3_BUCKET=docta-documents
