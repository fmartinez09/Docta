# Neutral native-setup template. Fill credentials locally; never commit the resulting .env.
# Devcontainer users run npm run dev:configure instead; root .env is never copied automatically.
DOCTA_ENVIRONMENT=development
# Required: percent-encode username/password in the DSN and match your published database port.
# DOCTA_DATABASE_URL=postgresql://<user>:<encoded-password>@127.0.0.1:5432/<database>
DOCTA_MINIO_HEALTH_URL=http://127.0.0.1:9000/minio/health/ready
DOCTA_DEPENDENCY_TIMEOUT_SECONDS=2
DOCTA_API_BASE_URL=http://127.0.0.1:8000
DOCTA_WEB_ORIGIN=http://127.0.0.1:3000
# DOCTA_WEB_SESSION_SECRET=<random-secret-of-at-least-32-characters>
# DOCTA_WEB_OIDC_CLIENT_ID=<actual-public-client-id>
# DOCTA_WEB_OIDC_SCOPES=openid profile urn:zitadel:iam:org:project:id:<project-id>:aud
DOCTA_S3_ENDPOINT_URL=http://127.0.0.1:9000
# Configure access/secret keys together, matching your local storage credentials.
# DOCTA_S3_ACCESS_KEY=<your-access-key>
# DOCTA_S3_SECRET_KEY=<your-secret-key>
DOCTA_S3_BUCKET=docta-documents
DOCTA_S3_REGION=us-east-1
DOCTA_UPLOAD_TTL_SECONDS=900
DOCTA_MAX_DOCUMENT_BYTES=10485760
DOCTA_MAX_DOCUMENT_PAGES=200
DOCTA_CHUNK_SIZE_CHARACTERS=1600
DOCTA_CHUNK_OVERLAP_CHARACTERS=160
DOCTA_PIPELINE_VERSION=phase0-pymupdf-v1
DOCTA_REDIS_URL=redis://127.0.0.1:6379/0
DOCTA_REDIS_STREAM=docta:jobs:ingestion:v1
DOCTA_REDIS_GROUP=docta-ingestion-workers-v1
DOCTA_JOB_LEASE_SECONDS=300
DOCTA_JOB_MAX_ATTEMPTS=3
DOCTA_JOB_RETRY_BASE_SECONDS=2
DOCTA_JOB_RECONCILE_SECONDS=30
# Optional real tutor: set all three together. No selected model, API key or paid provider.
# DOCTA_TUTOR_ENDPOINT_URL=<your-full-chat-completions-endpoint>
# DOCTA_TUTOR_MODEL=<your-model-id-or-server-alias>
# DOCTA_TUTOR_API_KEY=<your-private-key>
DOCTA_TUTOR_TIMEOUT_SECONDS=45
DOCTA_TUTOR_MAX_OUTPUT_TOKENS=2000
# llama_cpp changes sampling grammar only; local response/citation validation stays strict.
DOCTA_TUTOR_SCHEMA_PROFILE=standard
DOCTA_TUTOR_PROVIDER=chat_completions
DOCTA_MESSAGE_TIMEOUT_SECONDS=90
REDIS_PORT=6379

# Configure all three together from your identity provider; never substitute an Application ID.
# DOCTA_OIDC_ISSUER=<your-issuer>
# DOCTA_OIDC_AUDIENCE=<your-project-id>
# DOCTA_OIDC_JWKS_URL=<your-jwks-url>
# Authorization Code + PKCE helper: actual Client/Project IDs, optional developer login hint.
# DOCTA_DEV_OIDC_ISSUER=<your-issuer>
# DOCTA_DEV_OIDC_PROJECT_ID=<your-project-id>
# DOCTA_DEV_OIDC_CLIENT_ID=<your-public-client-id>
DOCTA_DEV_OIDC_REDIRECT_URI=http://127.0.0.1:8765/callback
# DOCTA_DEV_OIDC_LOGIN_HINT=<your-login>

# Native Compose refuses missing credentials. Existing databases need their original values.
# POSTGRES_DB=<your-database>
# POSTGRES_USER=<your-database-role>
# POSTGRES_PASSWORD=<your-private-password>
POSTGRES_PORT=5432
# MINIO_ROOT_USER=<your-access-key>
# MINIO_ROOT_PASSWORD=<your-private-secret>
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
