DOCTA_ENVIRONMENT=development
DOCTA_DATABASE_URL=postgresql://docta:docta_local_only@127.0.0.1:5432/docta
DOCTA_MINIO_HEALTH_URL=http://127.0.0.1:9000/minio/health/ready
DOCTA_DEPENDENCY_TIMEOUT_SECONDS=2
DOCTA_API_BASE_URL=http://127.0.0.1:8000
DOCTA_S3_ENDPOINT_URL=http://127.0.0.1:9000
DOCTA_S3_ACCESS_KEY=docta-local
DOCTA_S3_SECRET_KEY=docta-local-secret
DOCTA_S3_BUCKET=docta-documents
DOCTA_S3_REGION=us-east-1
DOCTA_UPLOAD_TTL_SECONDS=900
DOCTA_MAX_DOCUMENT_BYTES=10485760
DOCTA_MAX_DOCUMENT_PAGES=200
DOCTA_CHUNK_SIZE_CHARACTERS=1600
DOCTA_CHUNK_OVERLAP_CHARACTERS=160
DOCTA_PIPELINE_VERSION=phase0-pymupdf-v1
DOCTA_REDIS_URL=redis://127.0.0.1:6379/0
DOCTA_REDIS_STREAM=docta:jobs:ingestion:v1
DOCTA_REDIS_GROUP=docta-ingestion-workers-v1
DOCTA_JOB_LEASE_SECONDS=300
DOCTA_JOB_MAX_ATTEMPTS=3
DOCTA_JOB_RETRY_BASE_SECONDS=2
DOCTA_JOB_RECONCILE_SECONDS=30
REDIS_PORT=6379

# Local ZITADEL values for authenticated course endpoints. The API stays fail-closed when omitted.
DOCTA_OIDC_ISSUER=http://localhost:8080
DOCTA_OIDC_AUDIENCE=389218636289540099
DOCTA_OIDC_JWKS_URL=http://localhost:8080/oauth/v2/keys

# Development Authorization Code + PKCE helper. Set the application's Token Type to JWT, copy its
# OIDC Client ID, and register the redirect URI. Do not infer the Client ID from other identifiers.
# DOCTA_DEV_OIDC_CLIENT_ID=<client-id-from-zitadel>
DOCTA_DEV_OIDC_ISSUER=http://localhost:8080
DOCTA_DEV_OIDC_PROJECT_ID=389218636289540099
DOCTA_DEV_OIDC_REDIRECT_URI=http://127.0.0.1:8765/callback
DOCTA_DEV_OIDC_LOGIN_HINT=fernando.dev

POSTGRES_DB=docta
POSTGRES_USER=docta
POSTGRES_PASSWORD=docta_local_only
POSTGRES_PORT=5432

MINIO_ROOT_USER=docta-local
MINIO_ROOT_PASSWORD=docta-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
