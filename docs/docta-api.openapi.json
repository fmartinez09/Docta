            "title": "Content Hash"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "document_version_id",
          "document_title",
          "document_sha256",
          "page",
          "page_end",
          "fragment",
          "content_hash",
          "quote"
        ],
        "title": "CitationView"
